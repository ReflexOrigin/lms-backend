{
    "kind": "collectionType",
    "collectionName": "categories",
    "info": {
        "singularName": "category",
        "pluralName": "categories",
        "displayName": "Category"
    },
    "options": {
        "draftAndPublish": false
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "unique": true
        },
        "description": {
            "type": "text"
        },
        "courses": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::course.course",
            "mappedBy": "category"
        },
        "blogPosts": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::blog-post.blog-post",
            "mappedBy": "category"
        }
    }
}

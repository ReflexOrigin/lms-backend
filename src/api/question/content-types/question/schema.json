{
  "kind": "collectionType",
  "collectionName": "questions",
  "info": {
    "singularName": "question",
    "pluralName": "questions",
    "displayName": "Question"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "text": {
      "type": "string",
      "required": true
    },
    "options": {
      "type": "json",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "mcq",
        "multi_select"
      ],
      "default": "mcq"
    },
    "correctAnswer": {
      "type": "json",
      "required": true,
      "private": true
    },
    "feedback": {
      "type": "text",
      "private": true
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "questions"
    }
  }
}